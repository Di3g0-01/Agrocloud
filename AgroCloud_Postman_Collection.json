            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@ejemplo.com\",\n  \"password\": \"ClaveSegura123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const result = pm.response.json();",
                  "  if (result.token) pm.collectionVariables.set('token', result.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Usuario actual",
          "request": {
            "method": "GET",
            "description": "Rol: Autenticado. Ruta comprobada contra los controladores de develop.",
