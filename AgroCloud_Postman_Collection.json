{
  "info": {
    "name": "AgroCloud - API disponible en develop (E03)",
    "description": "Colección local de los endpoints presentes en develop. Usa credenciales de prueba; no contiene secretos ni URL pública. Cambia el token al probar cada rol. Los módulos nuevos del E04 se agregarán en fases posteriores.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "planId",
      "value": "plan-finca"
    },
    {
      "key": "subscriptionId",
      "value": ""
    },
    {
      "key": "instanceId",
      "value": ""
    },
    {
      "key": "templateId",
      "value": ""
    },
    {
      "key": "incidentId",
      "value": ""
    },
    {
      "key": "plantillaNombre",
      "value": "Cultivos y parcelas"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrar cliente",
          "request": {
            "method": "POST",
            "description": "Rol: Público. Ruta comprobada contra los controladores de develop.",
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationName\": \"Finca Los Pinos\",\n  \"contactName\": \"Carlos Monterroso\",\n  \"email\": \"cliente@ejemplo.com\",\n  \"phone\": \"+502 4455 6677\",\n  \"password\": \"ClaveSegura123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "description": "Rol: Público. Ruta comprobada contra los controladores de develop.",
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
