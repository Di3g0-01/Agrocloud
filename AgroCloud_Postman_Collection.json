    {
      "name": "Incidencias E04",
      "item": [
        {
          "name": "Listar incidencias",
          "request": {
            "method": "GET",
            "description": "Rol: Autenticado; resultados según rol. Ruta comprobada contra los controladores de develop.",
            "url": "{{baseUrl}}/incidencias"
          }
        },
        {
          "name": "Crear incidencia",
          "request": {
            "method": "POST",
            "description": "Rol: Cliente propietario de la instancia. Crea el ticket abierto y sin agente.",
            "url": "{{baseUrl}}/incidencias",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instanciaId\": \"{{instanciaId}}\",\n  \"asunto\": \"No puedo conectar\",\n  \"categoria\": \"Conectividad\",\n  \"problema\": \"La conexión falla desde esta mañana\",\n  \"prioridad\": \"ALTA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const result = pm.response.json();",
                  "  if (result.id) pm.collectionVariables.set('incidentId', result.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar guía de diagnóstico",
          "request": {
            "method": "PATCH",
            "description": "Rol: Admin o agente de Soporte asignado. Ruta de compatibilidad del frontend.",
            "url": "{{baseUrl}}/incidencias/{{incidentId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guiaDiagnostico\": \"Revisar conexión\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cliente - listar tickets propios",
          "request": {
            "method": "GET",
            "description": "Rol: Cliente con este clienteId o Admin. Otro cliente recibe 403.",
            "url": "{{baseUrl}}/incidencias/cliente/{{clienteId}}"
          }
        },
        {
          "name": "Soporte - listar tickets asignados",
          "request": {
            "method": "GET",
            "description": "Rol: Agente con este agenteId o Admin. Otro agente recibe 403.",
            "url": "{{baseUrl}}/incidencias/agente/{{agenteId}}"
          }
        },
        {
          "name": "Admin - asignar ticket",
          "request": {
            "method": "PATCH",
            "description": "Rol: Admin. El agente debe tener rol SOPORTE y estar activo.",
            "url": "{{baseUrl}}/incidencias/{{incidentId}}/asignacion",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agenteId\": \"{{agenteId}}\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Soporte - iniciar atención",
          "request": {
            "method": "PATCH",
            "description": "Rol: Agente asignado o Admin. Transición ABIERTA a EN_REVISION.",
            "url": "{{baseUrl}}/incidencias/{{incidentId}}/estado",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EN_REVISION\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Soporte - resolver ticket",
          "request": {
            "method": "PATCH",
            "description": "Rol: Agente asignado o Admin. Transición EN_REVISION a RESUELTA; el mensaje al cliente es obligatorio.",
            "url": "{{baseUrl}}/incidencias/{{incidentId}}/estado",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"RESUELTA\",\n  \"mensajeResolucion\": \"Se restauró la conexión y se verificó que la instancia funciona correctamente.\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Cliente - cerrar ticket",
          "request": {
            "method": "PATCH",
            "description": "Rol: Cliente propietario o Admin. CERRADA es estado final; no se reabre.",
            "url": "{{baseUrl}}/incidencias/{{incidentId}}/estado",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"CERRADA\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          }
        }
      ]
