POSTGRES_DB=agrocloud_db
POSTGRES_USER=agrocloud_user
POSTGRES_PASSWORD=elige-una-contrasena-local
JWT_SECRET=elige-una-clave-base64-de-al-menos-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443

# Backend: destino de los enlaces; en Render usar https://agrocloud-three.vercel.app
APP_FRONTEND_URL=http://localhost:5173
# smtp para un buzón local; brevo para enviar por HTTPS tanto en local como en Render.
MAIL_PROVIDER=smtp
MAIL_FROM=AgroCloud <no-reply@agrocloud.local>
# Con MAIL_PROVIDER=brevo: usar una clave API (no SMTP) y un MAIL_FROM verificado.
BREVO_API_KEY=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL=false
